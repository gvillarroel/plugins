{
  "name": "kc-lineage-view",
  "version": "0.3.0",
  "private": true,
  "description": "Reproducible build of the official MCP Apps host bridge; no CDN at runtime",
  "scripts": {
    "build": "esbuild host-bridge.js --bundle --minify --format=iife --target=es2022 --legal-comments=linked --outfile=../src/knowledge_catalog/host-bridge.js",
    "build:qa": "esbuild qa-host.js --bundle --format=esm --target=es2022 --outfile=../output/lineage-qa-host.js",
    "qa": "node qa-server.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "esbuild": "0.28.2"
  }
}
