  "subtitleLayouts": {
    "intro/1": [
      "Los bonos del Tesoro\na largo plazo subieron."
    ],
    "bolsa/0": [
      "En bolsa, el índice\nde las quinientas grandes empresas",
      "cayó un ocho coma seis por ciento."
    ],
    "btc/0": [
      "Bitcóin tuvo la mayor caída\nde la comparación."
    ],
    "btc/1": [
      "De viernes a viernes perdió\ncasi el catorce por ciento",
      "y cerró por debajo\nde los cincuenta y nueve mil dólares."
    ],
    "bonos/2": [
      "Cuando baja el rendimiento\nque exigen los compradores,",
      "los bonos ya emitidos,\nque pagan un interés fijo, ganan valor."
    ],
    "bonos/3": [
      "Esa semana, el rendimiento\ndel Tesoro a diez años",
      "bajó del cinco coma quince\nal cuatro coma noventa y dos por ciento."
    ]
  }
